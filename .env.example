# Copy this file to .env and fill in your own values:  cp .env.example .env

# Database
POSTGRES_DB=quickformcv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Backend auth (generate a key with: openssl rand -hex 32)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq (AI features) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Cloudinary (image uploads) - https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v0/auth/callback

# URLs / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v0
NEXT_PUBLIC_APP_URL=http://localhost:3000

DEBUG=false
